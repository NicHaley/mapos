# Copy to .env and fill in. Only needed for region-pack downloads and for
# building a signed release; `pnpm dev` works without any of it.

# Public base URL of the R2 bucket holding region packs and their manifest.
# Without it, the Offline tab reports that region packs are not configured.
MAIN_VITE_R2_PUBLIC_URL=

# ── Release signing (maintainers only) ────────────────────────────────────────
# publish-release.sh sources this file with `set -a`, so everything here is
# exported to electron-builder during build:mac.

# macOS signing identity, e.g. "Jane Doe (ABCDE12345)". Omit to let
# electron-builder auto-discover a Developer ID in your keychain, or set
# CSC_IDENTITY_AUTO_DISCOVERY=false to skip signing entirely.
CSC_NAME=

# Notarization. Required only when the build is signed.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
