# Protomaps API key — required for map tile rendering
RENDERER_VITE_PROTOMAPS_KEY=

# Optional: R2 public URL for self-hosted PMTiles
# When set, the app fetches manifest.json from this URL and shows a region
# picker on the map so you can switch from the Protomaps API to self-hosted tiles.
# Set this to the same value as R2_PUBLIC_URL in your root .env.
# RENDERER_VITE_R2_PUBLIC_URL=https://pub-abc123.r2.dev
