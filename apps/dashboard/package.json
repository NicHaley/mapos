    "@turf/intersect": "^7.3.5",
    "@turf/length": "^7.3.5",
    "@turf/simplify": "^7.3.5",
    "@turf/union": "^7.3.5",
    "@valhallajs/valhallajs": "^3.7.0",
    "better-sqlite3": "^12.8.0",
    "dotted-map": "^3.1.0",
    "drizzle-orm": "^0.44.2",
    "electron-updater": "^6.6.2",
    "gray-matter": "^4.0.3",
    "pmtiles": "^4.4.1",
    "typebox": "^1.1.38",
    "wellknown": "^0.5.0",
    "zod": "^4.0.0"
