    "maplibre-gl": "^5.18.0",
    "media-chrome": "^4.18.0",
    "motion": "^12.36.0",
    "nanoid": "^5.1.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-icons": "^5.6.0",
    "react-map-gl": "^8.1.0",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
