    "@tiptap/extension-bubble-menu": "^3.21.0",
    "@tiptap/extension-link": "^3.21.0",
    "@tiptap/markdown": "^3.21.0",
    "@tiptap/pm": "^3.21.0",
    "@tiptap/react": "^3.21.0",
    "@tiptap/starter-kit": "^3.21.0",
    "@tiptap/suggestion": "^3.21.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^8.0.0",
    "@types/geojson": "^7946.0.16",
