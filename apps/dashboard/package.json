{
  "name": "@mapos/dashboard",
  "version": "1.0.0-beta.10",
  "description": "An Electron application with React and TypeScript",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "fetch:assets": "node scripts/fetch-basemap-assets.mjs",
    "build": "npm run fetch:assets && npm run typecheck && electron-vite build",
    "typecheck": "tsc -b --noEmit",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "release": "./scripts/publish-release.sh"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@mapos/contracts": "workspace:*",
    "@mapos/service-adapters": "workspace:*",
    "@mapos/ui": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@protomaps/basemaps": "^5.7.2",
    "@tanstack/react-virtual": "^3.13.12",
    "@tiptap/extension-image": "^3.27.1",
    "@turf/area": "^7.3.5",
    "@turf/bbox": "^7.3.4",
    "@turf/boolean-intersects": "^7.3.5",
    "@turf/boolean-point-in-polygon": "^7.3.5",
    "@turf/buffer": "^7.3.5",
