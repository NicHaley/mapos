{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mapos-api",
  "main": "src/index.cf.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PHOTON_URL": "https://photon.komoot.io",
    "VALHALLA_URL": "https://valhalla1.openstreetmap.de",
    "PROTOMAPS_STYLE_URL_BASE": "https://api.protomaps.com",
    "PROTOMAPS_TILE_URL_TEMPLATE": "https://api.protomaps.com/tiles/v3/{z}/{x}/{y}.mvt",
    "ALLOWED_ORIGINS": "",
    "NODE_ENV": "production"
  }
  // Secrets (set via `wrangler secret put`):
  //   PROTOMAPS_API_KEY
  // Custom domain binding (configure once in CF dashboard):
  //   routes: [{ pattern: "api.mapos.md", custom_domain: true }]
}
