# Template for .dev.vars (gitignored). Copy to .dev.vars and fill in real values.
#
# Only needed to run the Worker locally (cf:preview) — typecheck and `next dev`
# work without it.
#
# Add every new secret here. `wrangler types` discovers secret names by reading
# .dev.vars, since secrets aren't declared in wrangler.jsonc, and CI copies this
# file to verify the committed cloudflare-env.d.ts is current. A secret missing
# from this template fails that check.
NEXTJS_ENV=development
STATS_KEY=dummy-value-for-typegen
