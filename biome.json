{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 100,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "none",
      "jsxQuoteStyle": "double"
    }
  },
  "files": {
    "ignore": [
      "dist/**",
      "out/**",
      "**/.turbo/**",
      ".next/**",
      ".open-next/**",
      ".wrangler/**",
      "**/cloudflare-env.d.ts",
      "node_modules/**",
      "pnpm-lock.yaml"
    ]
  }
}
